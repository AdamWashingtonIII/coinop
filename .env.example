# COINOP env — copy to .env.local, never commit real values. See spec section 2.10 / 14.
# Network: base-sepolia for all pre-mainnet work (eip155:84532). Mainnet = eip155:8453.
NEXT_PUBLIC_CHAIN_ID=84532
# Treasury wallet that receives 0.25 USDC per play (payTo). ADDRESS ONLY, fresh wallet.
TREASURY_ADDRESS=0x0000000000000000000000000000000000000000
# Versus-match escrow (ADR 0009): both duel stakes settle to this wallet and
# settlement pays out from it. Needs a little chain-native ETH for gas.
MATCH_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
MATCH_ESCROW_PRIVATE_KEY=
# USDC contract per network (filled by chain config in lib/x402/config.ts)
# Base Sepolia USDC: 0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Base Mainnet USDC:  0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
DATABASE_URL=postgres://user:pass@localhost:5432/coinop
REDIS_URL=redis://localhost:6379
# HMAC secret for session tokens (generate: openssl rand -hex 32)
SESSION_HMAC_SECRET=replace-me
# x402 facilitator: testnet any; mainnet Coinbase CDP https://api.cdp.coinbase.com/platform/v2/x402
X402_FACILITATOR_URL=https://x402.org/facilitator
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# Public domain of the arcade (CSP frame-ancestors, CDN base)
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_COOKIE_SECRET=replace-me
